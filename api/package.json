{
  "name": "seatrush-api",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.13.0 || >=24.11.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node src/main.ts",
    "migration:run": "ts-node src/migrate.ts",
    "test": "mkdir -p .test-dist/test && tsc -p tsconfig.test.json && node --test .test-dist/test"
  },
  "dependencies": {
    "@nestjs/common": "^12.4.0",
    "@nestjs/core": "^12.4.0",
    "@nestjs/platform-express": "^12.4.0",
    "@nestjs/typeorm": "^12.0.3",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
